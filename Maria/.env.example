# Supabase — Project Settings → API in the Supabase dashboard.
# Both values are public: the anon key is meant to reach the browser and is
# constrained by your Row Level Security policies. Never add the service role
# key here or to any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The scene painter — Gemini on Google Cloud Vertex AI. Locally, no key: run
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project your-project-id
# and set the project below. On Vercel, use the VERTEX_WIF_* variables from the
# README instead. SERVER-ONLY: never give any of these a NEXT_PUBLIC_ prefix.
# Optional; without a sign-in, painting a scene says it is not set up.
VERTEX_PROJECT_ID=
# Vercel Production: IAM & Admin -> Workload Identity Federation / Service accounts.
# VERTEX_WIF_PROJECT_NUMBER=
# VERTEX_WIF_POOL_ID=vercel
# VERTEX_WIF_PROVIDER_ID=vercel
# VERTEX_SERVICE_ACCOUNT_EMAIL=
# Optional overrides.
# VERTEX_LOCATION=global
# Default gemini-3.1-flash-image; gemini-3-pro-image is sharper, slower, ~2x price:
# VERTEX_IMAGE_MODEL=gemini-3-pro-image
# Only where your organisation allows service account keys (base64 JSON):
# VERTEX_SERVICE_ACCOUNT_KEY=
