# Supabase — Project Settings → API in the Supabase dashboard.
# Both values are public: the anon key is meant to reach the browser and is
# constrained by your Row Level Security policies. Never add the service role
# key here or to any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
