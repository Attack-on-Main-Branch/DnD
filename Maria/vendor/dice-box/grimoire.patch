index 0000000..caa1259
--- /dev/null
+++ b/src/components/world/environment.js
@@ -0,0 +1,108 @@
+import { Constants } from '@babylonjs/core/Engines/constants'
+import { RawCubeTexture } from '@babylonjs/core/Materials/Textures/rawCubeTexture'
+import { HDRFiltering } from '@babylonjs/core/Materials/Textures/Filtering/hdrFiltering'
+
+// Grimoire Tales: what a PBR die reflects. Painted here rather than fetched,
+// so a table whose dice are all standard materials downloads nothing for it.
+
+const SIZE = 128
+
+// Where dice-box's directional light shines from (its direction, reversed),
+// so the softbox in a reflection agrees with the highlight the light draws.
+const KEY = normalize([0.3, 1, -0.4])
+const FILL = normalize([-0.7, 0.55, 0.45])
+
+function normalize([x, y, z]) {
+  const span = Math.hypot(x, y, z) || 1
+  return [x / span, y / span, z / span]
+}
+
+function smoothstep(edge0, edge1, value) {
+  const t = Math.min(1, Math.max(0, (value - edge0) / (edge1 - edge0)))
+  return t * t * (3 - 2 * t)
+}
+
+// A dark studio, the way metal is photographed: what makes a surface read as
+// metal is neighbouring faces showing very different things, so the room is
+// mostly shadow with a few large lights in it — a warm key softbox where
+// dice-box's own light hangs, a cooler fill, and windows round the horizon
+// that the side faces catch as the die turns.
+function radiance([x, y, z]) {
+  const base = y >= 0 ? 0.075 + 0.08 * y : 0.035
+
+  const key = smoothstep(0.82, 0.92, x * KEY[0] + y * KEY[1] + z * KEY[2])
+  const fill = smoothstep(0.86, 0.94, x * FILL[0] + y * FILL[1] + z * FILL[2])
+
+  const azimuth = Math.atan2(z, x)
+  const band = smoothstep(0.02, 0.08, y) * (1 - smoothstep(0.24, 0.32, y))
+  const windows = band * smoothstep(0.35, 0.75, Math.cos(3 * azimuth + 0.6))
+
+  return [
+    Math.min(1, base + key * 1.0 + fill * 0.6 + windows * 0.55),
+    Math.min(1, base + key * 0.95 + fill * 0.66 + windows * 0.55),
+    Math.min(1, base + key * 0.86 + fill * 0.76 + windows * 0.58),
+  ]
+}
+
+// The cube's faces in WebGL's order and orientation: +X, -X, +Y, -Y, +Z, -Z.
+const FACES = [
+  (u, v) => [1, -v, -u],
+  (u, v) => [-1, -v, u],
+  (u, v) => [u, 1, v],
+  (u, v) => [u, -1, -v],
+  (u, v) => [u, -v, 1],
+  (u, v) => [-u, -v, -1],
+]
+
+function createStudioEnvironment(scene) {
+  const faces = FACES.map((direction) => {
+    const data = new Uint8Array(SIZE * SIZE * 4)
+
+    for (let row = 0; row < SIZE; row++) {
+      for (let column = 0; column < SIZE; column++) {
+        const u = ((column + 0.5) / SIZE) * 2 - 1
+        const v = ((row + 0.5) / SIZE) * 2 - 1
+        const [r, g, b] = radiance(normalize(direction(u, v)))
+        const at = (row * SIZE + column) * 4
+
+        data[at] = Math.round(Math.pow(r, 1 / 2.2) * 255)
+        data[at + 1] = Math.round(Math.pow(g, 1 / 2.2) * 255)
+        data[at + 2] = Math.round(Math.pow(b, 1 / 2.2) * 255)
+        data[at + 3] = 255
+      }
+    }
+
+    return data
+  })
+
+  const texture = new RawCubeTexture(
+    scene,
+    faces,
+    SIZE,
+    Constants.TEXTUREFORMAT_RGBA,
+    Constants.TEXTURETYPE_UNSIGNED_BYTE,
+    true,
+    false,
+    Constants.TEXTURE_TRILINEAR_SAMPLINGMODE
+  )
+  texture.gammaSpace = true
+
+  // Blurred properly by roughness where the GPU can (WebGL 2); the mip chain
+  // alone where it cannot, which is coarser but still right for a room this
+  // smooth. The filtered maps swap in under the same texture, so the
+  // materials are told to look again once they have.
+  try {
+    new HDRFiltering(scene.getEngine(), {
+      quality: Constants.TEXTURE_FILTERING_QUALITY_HIGH,
+    })
+      .prefilter(texture)
+      .then(() => scene.markAllMaterialsAsDirty(Constants.MATERIAL_TextureDirtyFlag))
+      .catch(() => {})
+  } catch (error) {
+    // Left to the mip chain.
+  }
+
+  return texture
+}
+
+export { createStudioEnvironment }
