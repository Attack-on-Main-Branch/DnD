# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Patterns are intentionally unanchored: this is a workspace monorepo, so
# build output and dependencies appear under Maria/ and Shina/ as well as here.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# windows shell junk
Thumbs.db
ehthumbs.db
desktop.ini

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
